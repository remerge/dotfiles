#!zsh

# without `do`, every argument is a directory and there is no command
local -i doidx=${argv[(Ie)do]}
(( doidx )) || doidx=$(( $# + 1 ))
local dirs=("${(@)argv[1,doidx-1]}")
local cmd=("${(@)argv[doidx+1,-1]}")

# return to the calling directory even when ^C aborts the loop: the always
# block runs on interrupts too, where a trailing popd would be skipped
local start=${PWD} dir
{
    for dir in ${dirs[@]}; do
        echo -e "\n${dir:P}"
        cd "${dir:P}" || continue
        if (( ! $#cmd )); then
            # no command: open a shell in each dir, exit it to move to the next
            zsh -i
        else
            eval "${cmd[@]}"
        fi
        cd "${start}"
    done
} always {
    [[ ${PWD} == ${start} ]] || cd "${start}"
}
